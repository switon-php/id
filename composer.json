{
    "name": "switon/id",
    "description": "Named ID generators for UUIDs, ULIDs, Snowflake, and compact public IDs for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "ids",
        "snowflake",
        "uuid"
    ],
    "homepage": "https://github.com/switon-php/id",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/id",
        "issues": "https://github.com/switon-php/id/issues",
        "docs": "https://github.com/switon-php/id/blob/main/docs/README.md"
    },
    "require": {
        "php": ">=8.3",
        "switon/command": "^1.0",
        "switon/core": "^1.0",
        "switon/sync": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/redis": "^1.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "suggest": {
        "ext-gmp": "Required for KSUID and ShortUuid support.",
        "switon/redis": "Snowflake sequence allocation."
    },
    "autoload": {
        "psr-4": {
            "Switon\\Id\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Id\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "providers": [
                "Switon\\Id\\ServiceProvider"
            ],
            "commands": [
                "Switon\\Id\\Command\\IdCommand"
            ]
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
